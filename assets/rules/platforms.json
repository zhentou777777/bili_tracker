{
  "version": 5,
  "updated_at": "2026-10-02T16:00:00Z",
  "notes": "接口规则表。App 内置此文件作为兜底，启动时可拉取远端同名文件覆盖，接口变动无需发版。",
  "platforms": [
    {
      "id": "bilibili",
      "name": "哔哩哔哩",
      "brand_color": "#FB7299",
      "enabled": true,
      "sign": "wbi",
      "login_url": "https://passport.bilibili.com/h5-app/passport/login",
      "cookie_domains": [".bilibili.com"],
      "required_cookies": ["SESSDATA", "bili_jct", "DedeUserID"],
      "device_cookies": ["buvid3", "buvid4", "b_nut"],
      "self_uid_cookie": "DedeUserID",
      "self_check_endpoint": "nav",
      "login": {
        "mode": "qr_deeplink",
        "note": "扫码登录 + 同设备一键跳转 B 站 App 确认。旧 WebView 登录保留为兜底入口（见 login_url）。",
        "qr_generate_url": "https://passport.bilibili.com/x/passport-login/web/qrcode/generate",
        "qr_generate_params": { "source": "main-fe-header", "go_url": "https://www.bilibili.com/" },
        "qr_poll_url": "https://passport.bilibili.com/x/passport-login/web/qrcode/poll",
        "qr_poll_params": { "qrcode_key": "{qrcode_key}", "source": "main-fe-header" },
        "cross_domain_referer": "https://www.bilibili.com/",
        "poll_interval_ms": 2000,
        "qr_ttl_seconds": 180,
        "url_path": "data.url",
        "key_path": "data.qrcode_key",
        "status_path": "data.code",
        "status_map": {
          "0": "success",
          "86090": "scanned",
          "86101": "waiting",
          "86038": "expired"
        },
        "note_status": "外层 code 恒为 0（仅代表 HTTP 层成功），扫码状态一律看 status_path。这是最常见的翻车点：只看外层会立刻判定「登录成功」但 Cookie 为空。"
      },
      "endpoints": {
        "nav": {
          "url": "https://api.bilibili.com/x/web-interface/nav",
          "method": "GET",
          "referer": "https://www.bilibili.com/",
          "require_cookie": false,
          "require_sign": false,
          "note": "WBI 密钥来源；未登录也返回 wbi_img"
        },
        "followings": {
          "url": "https://api.bilibili.com/x/relation/followings",
          "method": "GET",
          "referer": "https://space.bilibili.com/{self_uid}/fans/follow",
          "require_cookie": true,
          "require_sign": false,
          "params": { "vmid": "{self_uid}", "pn": "{page}", "ps": "50", "order": "desc", "order_type": "attention" },
          "list_path": "data.list",
          "total_path": "data.total",
          "parser": "generic",
          "item_map": { "uid": "mid", "name": "uname", "face": "face", "sign": "sign" }
        },
        "dynamics": {
          "url": "https://api.bilibili.com/x/polymer/web-dynamic/v1/feed/space",
          "method": "GET",
          "referer": "https://space.bilibili.com/{uid}/dynamic",
          "require_cookie": true,
          "require_sign": false,
          "params": {
            "host_mid": "{uid}",
            "offset": "{offset}",
            "timezone_offset": "-480",
            "features": "itemOpusStyle,listOnlyfans,opusBigCover,onlyfansVote"
          },
          "list_path": "data.items",
          "next_offset_path": "data.offset",
          "has_more_path": "data.has_more",
          "parser": "bilibili_dynamic",
          "note": "2026-10 起替代已下线的 dynamic_svr/space_history（旧接口实测 HTTP 404）。首屏 offset 传空（与网页端一致）：另有一次实测 offset=0 返回空列表，但同批请求均处于 -352 限流，无法排除干扰，故不做定论，只按网页端行为传空。翻页用上一页返回的 data.offset。"
        },
        "live_history": {
          "url": "https://api.bilibili.com/x/web-interface/history/cursor",
          "method": "GET",
          "referer": "https://www.bilibili.com/account/history/",
          "require_cookie": true,
          "require_sign": false,
          "params": {
            "ps": "30",
            "type": "live",
            "max": "{max}",
            "business": "{business}",
            "view_at": "{view_at}"
          },
          "list_path": "data.list",
          "parser": "bilibili_live_history",
          "note": "最近观看的直播记录（需登录，未登录回 -101）。max/business/view_at 是翻页游标，首页不传；ps 最大 30。用于「自动追更最近观看直播的已关注主播」。"
        },
        "videos": {
          "url": "https://api.bilibili.com/x/space/arc/search",
          "method": "GET",
          "referer": "https://space.bilibili.com/{uid}/video",
          "require_cookie": true,
          "require_sign": true,
          "params": { "mid": "{uid}", "pn": "{page}", "ps": "30", "order": "pubdate", "platform": "web", "web_location": "1550101" },
          "list_path": "data.list.vlist",
          "parser": "generic",
          "item_map": { "id": "bvid", "title": "title", "cover": "pic", "time": "created", "desc": "description", "duration": "length", "play": "play" }
        },
        "live_status": {
          "url": "https://api.live.bilibili.com/room/v1/Room/get_status_info_by_uids",
          "method": "GET",
          "referer": "https://live.bilibili.com/",
          "require_cookie": false,
          "require_sign": false,
          "repeat_param": { "uids[]": "{uid}" },
          "parser": "bilibili_live",
          "note": "公开接口，实测无需 Cookie —— 后台开播轮询依赖它，App 被杀后也可由服务端兜底"
        },
        "user_info": {
          "url": "https://api.bilibili.com/x/space/wbi/acc/info",
          "method": "GET",
          "referer": "https://space.bilibili.com/{uid}/",
          "require_cookie": false,
          "require_sign": true,
          "params": { "mid": "{uid}", "platform": "web", "web_location": "1550101" },
          "parser": "generic",
          "item_map": { "uid": "mid", "name": "name", "face": "face", "sign": "sign" }
        }
      }
    },
    {
      "id": "weibo",
      "name": "微博",
      "brand_color": "#E6162D",
      "enabled": false,
      "sign": "none",
      "login_url": "https://passport.weibo.com/sso/signin",
      "cookie_domains": [".weibo.com", ".sina.com.cn"],
      "required_cookies": ["SUB", "SUBP", "SSOLoginState"],
      "device_cookies": [],
      "self_uid_cookie": "",
      "self_check_endpoint": "",
      "endpoints": {
        "followings": {
          "url": "https://weibo.com/ajax/profile/followContent",
          "method": "GET",
          "referer": "https://weibo.com/",
          "require_cookie": true,
          "require_sign": false,
          "params": { "uid": "{self_uid}", "page": "{page}" },
          "list_path": "data.follows",
          "parser": "generic",
          "item_map": { "uid": "id", "name": "screen_name", "face": "profile_image_url" }
        },
        "dynamics": {
          "url": "https://weibo.com/ajax/statuses/mymblog",
          "method": "GET",
          "referer": "https://weibo.com/u/{uid}",
          "require_cookie": true,
          "require_sign": false,
          "params": { "uid": "{uid}", "page": "{page}", "feature": "0" },
          "list_path": "data.list",
          "parser": "weibo_status"
        }
      }
    }
  ]
}
